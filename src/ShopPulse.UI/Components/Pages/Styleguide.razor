@page "/styleguide"

<PageTitle>Styleguide — ShopPulse</PageTitle>
<h1>Styleguide ShopPulse.UI</h1>
<p>Catalogue vivant du design system : chaque composant avec ses variantes. Sert aussi de test visuel.</p>

<h2>Button</h2>
<Button Variant="Button.ButtonVariant.Primary">Primaire</Button>
<Button Variant="Button.ButtonVariant.Secondary">Secondaire</Button>
<Button Variant="Button.ButtonVariant.Danger">Danger</Button>
<Button Variant="Button.ButtonVariant.Primary" Extra="@(new Dictionary<string, object> { ["aria-pressed"] = "false" })">
       Avec attributs passés (aria-pressed)
</Button>

<h2>ProductCard (présentation pure)</h2>
<div class="grid">
       <ProductCard ImageUrl="/img/p1.jpg" Name="Produit démo" Price="@(19.99m)" Stock="12" Priority="true">
              <a href="/catalog">Voir</a>
       </ProductCard>
       <ProductCard ImageUrl="/img/p2.jpg" Name="Produit en rupture" Price="@(5m)" Stock="0" />
</div>

