@* Lien WhatsApp réutilisable (docs/31) : numéro lu dans la configuration
   (Store:WhatsApp — jamais en dur), message pré-rempli fourni par le parent.
   Simple lien sortant https://wa.me/… : aucun script tiers, CSP intacte. *@
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<a class="@CssClass"
   href="https://wa.me/@(Config["Store:WhatsApp"] ?? "212700222673")?text=@Uri.EscapeDataString(Message)"
   target="_blank" rel="noopener"
   aria-label="@AriaLabel">
       @if (ShowIcon)
       {
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                     <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.86 9.86 0 0 0 12.04 2zm0 18.03h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.73-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z"/>
              </svg>
       }
       @ChildContent
</a>

@code {
       /// <summary>Message pré-rempli dans WhatsApp (encodé automatiquement).</summary>
       [Parameter, EditorRequired] public string Message { get; set; } = "";

       [Parameter] public string CssClass { get; set; } = "whatsapp-link";
       [Parameter] public bool ShowIcon { get; set; } = true;
       [Parameter] public string AriaLabel { get; set; } = "Nous contacter sur WhatsApp (nouvelle fenêtre)";
       [Parameter] public RenderFragment? ChildContent { get; set; }
}
