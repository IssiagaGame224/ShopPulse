@page "/admin/orders"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CanManageStock")]
@using Microsoft.Extensions.Localization
@using ShopPulse.UI.Resources
@inject IOrderAdmin Orders
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AdminOrdersTitle"] — ShopPulse</PageTitle>
<h1>@L["AdminOrdersTitle"]</h1>

<nav aria-label="@L["BackOffice"]">
       <a href="/admin/orders" aria-current="page">@L["AdminOrdersTitle"]</a> · <a href="/admin/products">@L["AdminProductsTitle"]</a>
</nav>

<p>
       <label for="filtre">@L["FilterStatus"]</label>
       <select id="filtre" @bind="_filter" @bind:after="FilterChangedAsync">
              <option value="">@L["FilterAll"]</option>
              <option value="Pending">@L["StatusPendingM"]</option>
              <option value="Paid">@L["StatusPaidM"]</option>
              <option value="Shipped">@L["StatusShippedM"]</option>
              <option value="Cancelled">@L["StatusCancelledM"]</option>
       </select>
</p>

@if (_orders is null)
{
       <p aria-busy="true">@L["Loading"]</p>
}
else if (_orders.Items.Count == 0)
{
       <p>@L["NoOrdersForFilter"]</p>
}
else
{
       <p class="results-count">@string.Format(L["AdminOrdersCount"], _orders.Total, _page, _pageCount)</p>
       <table>
              <thead>
                     <tr>
                            <th>@L["ColReference"]</th><th>@L["ColDate"]</th><th>@L["ColCustomer"]</th>
                            <th>@L["ColTotal"]</th><th>@L["ColStatus"]</th><th>@L["ColActions"]</th>
                     </tr>
              </thead>
              <tbody>
                     @foreach (var order in _orders.Items)
                     {
                            <tr @key="order.Id">
                                   <td>@order.Id.ToString("N")[..8].ToUpperInvariant()</td>
                                   <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                   <td>@order.FullName<br /><small>@order.Email</small></td>
                                   <td>@order.Total.ToString("0.00") @order.Currency</td>
                                   <td>@StatusLabel(order.Status)</td>
                                   <td>
                                          @if (order.Status == OrderStatus.Pending)
                                          {
                                                 <button disabled="@_busy" @onclick="() => SetStatusAsync(order.Id, OrderStatus.Paid)">@L["MarkPaid"]</button>
                                          }
                                          @if (order.Status == OrderStatus.Paid)
                                          {
                                                 <button disabled="@_busy" @onclick="() => SetStatusAsync(order.Id, OrderStatus.Shipped)">@L["MarkShipped"]</button>
                                          }
                                          @if (order.Status is OrderStatus.Pending or OrderStatus.Paid)
                                          {
                                                 <button disabled="@_busy" @onclick="() => SetStatusAsync(order.Id, OrderStatus.Cancelled)">@L["CancelAction"]</button>
                                          }
                                   </td>
                            </tr>
                     }
              </tbody>
       </table>
       @if (_pageCount > 1)
       {
              <nav aria-label="@L["PaginationLabel"]" class="filters">
                     <button disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)">@L["PrevPage"]</button>
                     <span>@string.Format(L["PageXofY"], _page, _pageCount)</span>
                     <button disabled="@(_page >= _pageCount)" @onclick="() => GoToPageAsync(_page + 1)">@L["NextPage"]</button>
              </nav>
       }
}

@if (_error is not null)
{
       <p role="alert">@_error</p>
}

@code {
       private PagedResult<Order>? _orders;
       private string _filter = "";
       private int _page = 1;
       private int _pageCount = 1;
       private string? _error;
       private bool _busy;

       protected override Task OnInitializedAsync() => LoadAsync();

       private async Task LoadAsync()
       {
              OrderStatus? status = Enum.TryParse<OrderStatus>(_filter, out var s) ? s : null;
              _orders = await Orders.GetOrdersAsync(status, (_page - 1) * 25, 25);
              _pageCount = Math.Max(1, (int)Math.Ceiling(_orders.Total / 25.0));
       }

       private async Task FilterChangedAsync()
       {
              _page = 1;               // nouveau filtre = retour à la première page
              await LoadAsync();
       }

       private async Task GoToPageAsync(int page)
       {
              _page = Math.Clamp(page, 1, _pageCount);
              await LoadAsync();
       }

       private async Task SetStatusAsync(Guid id, OrderStatus status)
       {
              _busy = true;
              _error = null;
              try
              {
                     var result = await Orders.SetStatusAsync(id, status);
                     if (result.Error is not null) _error = result.Error;
                     await LoadAsync();
              }
              finally
              {
                     _busy = false;
              }
       }

       private string StatusLabel(OrderStatus status) => status switch
       {
              OrderStatus.Pending => L["StatusPending"],
              OrderStatus.Paid => L["StatusPaid"],
              OrderStatus.Shipped => L["StatusShipped"],
              OrderStatus.Cancelled => L["StatusCancelled"],
              _ => status.ToString(),
       };
}
