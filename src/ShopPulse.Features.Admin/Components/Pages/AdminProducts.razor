@page "/admin/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CanManageStock")]
@inject IProductService Products

<PageTitle>Produits — Back-office ShopPulse</PageTitle>
<h1>Produits</h1>

<nav aria-label="Back-office">
       <a href="/admin/orders">Commandes</a> · <a href="/admin/products" aria-current="page">Produits</a>
</nav>

<p><a href="/admin/products/new">+ Nouveau produit</a></p>

@if (_products is null)
{
       <p aria-busy="true">Chargement…</p>
}
else
{
       <table>
              <thead>
                     <tr>
                            <th>Référence</th><th>Nom</th><th>Catégorie</th>
                            <th>Prix</th><th>Prix barré</th><th>Stock</th><th></th>
                     </tr>
              </thead>
              <tbody>
                     @foreach (var p in _products)
                     {
                            <tr @key="p.Id">
                                   <td>@p.Sku</td>
                                   <td>@p.Name</td>
                                   <td>@p.Category</td>
                                   <td>@p.Price.ToString("0.00")</td>
                                   <td>@(p.OldPrice?.ToString("0.00") ?? "—")</td>
                                   <td>@p.Stock</td>
                                   <td><a href="/admin/products/@p.Id/edit">Modifier</a></td>
                            </tr>
                     }
              </tbody>
       </table>
}

@code {
       private IReadOnlyList<Product>? _products;

       protected override async Task OnInitializedAsync() =>
              _products = await Products.GetAllAsync();
}
