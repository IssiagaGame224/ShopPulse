@page "/admin/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CanManageStock")]
@using Microsoft.Extensions.Localization
@using ShopPulse.UI.Resources
@inject IProductService Products
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AdminProductsTitle"] — ShopPulse</PageTitle>
<h1>@L["AdminProductsTitle"]</h1>

<nav aria-label="@L["BackOffice"]">
       <a href="/admin/orders">@L["AdminOrdersTitle"]</a> · <a href="/admin/products" aria-current="page">@L["AdminProductsTitle"]</a> · <a href="/admin/reviews">@L["AdminReviewsTitle"]</a> · <a href="/admin/promo-codes">@L["AdminPromoTitle"]</a>
</nav>

<p><a href="/admin/products/new">@L["NewProduct"]</a></p>

@if (_products is null)
{
       <p aria-busy="true">@L["Loading"]</p>
}
else
{
       <div class="table-scroll" role="region" aria-label="Tableau — défilement horizontal" tabindex="0">
       <table>
              <thead>
                     <tr>
                            <th>@L["ColReference"]</th><th>@L["ColName"]</th><th>@L["ColCategory"]</th>
                            <th>@L["ColPrice"]</th><th>@L["ColOldPrice"]</th><th>@L["ColStock"]</th><th></th>
                     </tr>
              </thead>
              <tbody>
                     @foreach (var p in _products)
                     {
                            <tr @key="p.Id">
                                   <td>@p.Sku</td>
                                   <td>@p.Name</td>
                                   <td>@p.Category</td>
                                   <td>@p.Price.ToString("0.00")</td>
                                   <td>@(p.OldPrice?.ToString("0.00") ?? "—")</td>
                                   <td>@p.Stock</td>
                                   <td><a href="/admin/products/@p.Id/edit">@L["EditAction"]</a></td>
                            </tr>
                     }
              </tbody>
       </table>
       </div>
}

@code {
       private IReadOnlyList<Product>? _products;

       protected override async Task OnInitializedAsync() =>
              _products = await Products.GetAllAsync();
}
