@using Microsoft.Extensions.Localization
@using ShopPulse.UI.Resources
@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ShopPulse</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Principal">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Accueil
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog">
                <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Catalogue
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog-virtual">
                <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Catalogue (virtualisé)
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cart">
                <span class="bi bi-cart-nav-menu" aria-hidden="true"></span> Panier
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="checkout">
                <span class="bi bi-bag-nav-menu" aria-hidden="true"></span> Commande
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="styleguide">
                <span class="bi bi-palette-nav-menu" aria-hidden="true"></span> Styleguide
            </NavLink>
        </div>

        <AuthorizeView Roles="stock-manager">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/orders">
                        <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> @L["BackOffice"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Mon compte
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/login">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Se connecter
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
