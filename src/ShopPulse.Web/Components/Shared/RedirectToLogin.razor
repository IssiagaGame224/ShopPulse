@inject NavigationManager Nav

@* Redirection vers le challenge OIDC en conservant la page demandée (returnUrl validé
   côté serveur — anti open redirect, module 7). *@
@code {
       protected override void OnInitialized()
       {
              var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
              Nav.NavigateTo($"/login?returnUrl={returnUrl}");
       }
}
