@page "/catalog-virtual"
@rendermode InteractiveServer
@implements IDisposable
@inject IProductService Products

<PageTitle>Catalogue (virtualisé) — ShopPulse</PageTitle>
<h1>Catalogue</h1>

<input type="search" placeholder="Rechercher..."
            @bind="Search" @bind:event="oninput" @bind:after="OnSearchChanged" />

<div class="viewport">
       <Virtualize @ref="_virtualize" ItemsProvider="LoadProducts" ItemSize="220" OverscanCount="4" Context="p">
              <ItemContent>
                     <ProductCard @key="p.Id" ImageUrl="@p.ImageUrl" Name="@p.Name"
                                          Price="@p.Price" OldPrice="@p.OldPrice" Stock="@p.Stock">
                            <a href="/product/@p.Id">Voir</a>
                     </ProductCard>
              </ItemContent>
              <Placeholder>
                     <div class="skeleton" style="height:220px"></div>
              </Placeholder>
       </Virtualize>
</div>

@code {
       private Virtualize<Product>? _virtualize;
       private readonly Debouncer _debounce = new();
       private string _search = "";
       private string Search { get => _search; set => _search = value; }

       private async ValueTask<ItemsProviderResult<Product>> LoadProducts(ItemsProviderRequest req)
       {
              var page = await Products.GetPageAsync(req.StartIndex, req.Count, _search, null, req.CancellationToken);
              return new ItemsProviderResult<Product>(page.Items, page.Total);
       }

       private Task OnSearchChanged() =>
              _debounce.RunAsync(async ct =>
              {
                     await InvokeAsync(async () =>
                     {
                            if (_virtualize is not null)
                                   await _virtualize.RefreshDataAsync();
                     });
              }, TimeSpan.FromMilliseconds(300));

       public void Dispose() => _debounce.Dispose();
}
