@page "/checkout"
@rendermode InteractiveServer
@inherits ShopPulse.UI.ObserverComponent
@implements IAsyncDisposable
@inject CheckoutMachine Machine
@inject ICartGateway Cart
@inject IOrderPlacer OrderPlacer
@inject IOrderHistory OrderHistory
@inject IPaymentClient Payments
@inject IProductService Products
@inject IStoreConfigProvider StoreConfigProvider
@inject IPromoService Promos
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Commande — ShopPulse</PageTitle>
<h1>Commande</h1>

@* Tunnel (machine à états, module 3) + paiement (phase 6) : « Payer » crée la commande
   (idempotent) PUIS ouvre la session de paiement. Le montant vient de la commande
   persistée ; seul le webhook signé fait passer la commande à Paid. Sans clés Stripe
   configurées, un simulateur dev permet de tester toute la boucle. *@

<ol class="checkout-steps" aria-label="Étapes de commande">
       @foreach (var (step, label) in new[] { (CheckoutStep.Cart, "Panier"), (CheckoutStep.Shipping, "Livraison"), (CheckoutStep.Payment, "Paiement") })
       {
              <li aria-current="@(Machine.Step == step ? "step" : null)">@label</li>
       }
</ol>

@if (Machine.Step == CheckoutStep.Confirmed && _order is not null)
{
       <div role="status" class="summary-box">
              <p>Commande confirmée. Merci !</p>
              <p>
                     Référence : <strong>@_order.Id.ToString("N")[..8].ToUpperInvariant()</strong> —
                     total @_order.Total.ToString("0.00") @_order.Currency.
                     Un email de confirmation vient d'être envoyé à @_order.Email.
              </p>
              <p><a href="/account/orders">Suivre mes commandes</a></p>
              @* Contact direct au sujet de CETTE commande : le message pré-rempli porte
                 la référence et le montant — le client n'a rien à recopier (docs/31). *@
              <p>
                     <WhatsAppCta Message="@OrderWhatsAppMessage">
                            Une question sur cette commande ? Écrivez-nous sur WhatsApp
                     </WhatsAppCta>
              </p>
       </div>
}
else
{
       @* Mise en page « boutique pro » (référence joutech.ma, docs/32) : étapes
          numérotées à gauche, récapitulatif « Votre commande » collant à droite —
          valeurs serveur dès que la commande existe, aperçu panier avant. *@
       <div class="checkout-layout">
              <div class="checkout-main">
                     @if (Machine.Step == CheckoutStep.Shipping)
                     {
                            <section class="checkout-section" aria-labelledby="shipping-title">
                                   <h2 id="shipping-title"><span class="step-number" aria-hidden="true">1</span> Informations de livraison</h2>
                                   <ShippingFormView Submitted="OnShippingSubmitted" />
                            </section>
                     }
                     else if (Machine.Step == CheckoutStep.Failed)
                     {
                            <section class="checkout-section">
                                   <p role="alert">@(_error ?? "La commande a échoué.")</p>
                                   <button disabled="@(!Machine.CanFire(CheckoutEvent.Retry) || _placing)"
                                           @onclick="() => Machine.Fire(CheckoutEvent.Retry)">Réessayer</button>
                            </section>
                     }
                     else if (Machine.Step == CheckoutStep.Payment)
                     {
                            <section class="checkout-section" aria-labelledby="payment-title">
                                   <h2 id="payment-title"><span class="step-number" aria-hidden="true">2</span> Paiement</h2>
                                   @if (_session is null)
                                   {
                                          <p>@Cart.Lines.Count article(s) — le montant exact est calculé côté serveur.</p>
                                          <div class="checkout-actions">
                                                 <button disabled="@(!Machine.CanFire(CheckoutEvent.Back) || _placing)"
                                                         @onclick="() => Machine.Fire(CheckoutEvent.Back)">Retour</button>
                                                 <button class="sp-btn sp-btn--primary" disabled="@_placing" @onclick="PayAsync">
                                                        @(_placing ? "Commande en cours…" : "Payer")
                                                 </button>
                                          </div>
                                   }
                                   else if (!_session.Live)
                                   {
                                          @* Simulateur dev (aucune clé Stripe configurée) *@
                                          <div class="summary-box">
                                                 <p><strong>Mode démo</strong> — aucune clé Stripe configurée :
                                                        le paiement est simulé côté serveur.</p>
                                                 <p>Total à payer : <strong>@_order!.Total.ToString("0.00") @_order.Currency</strong></p>
                                                 <button class="sp-btn sp-btn--primary" disabled="@_placing" @onclick="FakePayAsync">
                                                        @( _placing ? "Paiement en cours…" : "Simuler le paiement (démo)")
                                                 </button>
                                          </div>
                                   }
                                   else
                                   {
                                          @* Stripe : le Payment Element est monté par JS interop *@
                                          <div class="summary-box">
                                                 <p>Total à payer : <strong>@_order!.Total.ToString("0.00") @_order.Currency</strong></p>
                                                 <div id="stripe-payment-element"></div>
                                                 @if (_paymentError is not null)
                                                 {
                                                        <p role="alert">@_paymentError</p>
                                                 }
                                                 <button class="sp-btn sp-btn--primary" disabled="@(_placing || !_elementMounted)"
                                                         @onclick="ConfirmStripeAsync">
                                                        @(_placing ? "Paiement en cours…" : "Confirmer le paiement")
                                                 </button>
                                          </div>
                                   }
                                   @if (_error is not null && _session is null)
                                   {
                                          <p role="alert">@_error</p>
                                   }
                            </section>
                     }
                     else
                     {
                            <section class="checkout-section" aria-labelledby="cart-review-title">
                                   <h2 id="cart-review-title">Votre panier</h2>
                                   <p>@Cart.Lines.Count article(s) dans votre panier — vérifiez le récapitulatif avant de continuer.</p>
                                   <button class="sp-btn sp-btn--primary"
                                           disabled="@(!Machine.CanFire(CheckoutEvent.Next) || Cart.Lines.Count == 0)"
                                           @onclick="() => Machine.Fire(CheckoutEvent.Next)">Suivant</button>
                            </section>
                     }
              </div>

              <aside class="checkout-summary" aria-labelledby="order-summary-title">
                     <h2 id="order-summary-title">Votre commande</h2>
                     <ul class="checkout-summary-lines">
                            @foreach (var line in SummaryLines)
                            {
                                   <li @key="line.ProductId">
                                          @if (_products.TryGetValue(line.ProductId, out var product))
                                          {
                                                 <img src="@product.ImageUrl" alt="" width="48" height="48" loading="lazy" decoding="async" />
                                          }
                                          <span class="summary-line-name">@line.Name <span class="summary-line-qty">× @line.Quantity</span></span>
                                          <span class="summary-line-total">@line.LineTotal.ToString("C")</span>
                                   </li>
                            }
                     </ul>
                     <dl>
                            <div>
                                   <dt>Sous-total</dt>
                                   <dd>@SummarySubtotal.ToString("C")</dd>
                            </div>
                            @if (SummaryDiscount > 0)
                            {
                                   <div class="discount">
                                          <dt>Remise@(SummaryPromoCode is { } code ? $" ({code})" : "")</dt>
                                          <dd>−@SummaryDiscount.ToString("C")</dd>
                                   </div>
                            }
                            <div>
                                   <dt>Livraison</dt>
                                   <dd>@(SummaryShipping > 0 ? SummaryShipping.ToString("C") : "Offerte")</dd>
                            </div>
                            <div class="total">
                                   <dt>Total</dt>
                                   <dd>@SummaryTotal.ToString("C")</dd>
                            </div>
                            <div>
                                   <dt>dont TVA @(((_order?.TaxRate ?? _store.VatRate) * 100).ToString("0")) %</dt>
                                   <dd>@SummaryTax.ToString("C")</dd>
                            </div>
                     </dl>
                     <p class="checkout-secure">Prix recalculés côté serveur — paiement sécurisé.</p>
              </aside>
       </div>
}

@code {
       private ShippingForm? _shipping;
       private string? _idempotencyKey;
       private Order? _order;
       private PaymentSession? _session;
       private string? _error;
       private string? _paymentError;
       private bool _placing;
       private bool _elementMounted;
       private IJSObjectReference? _stripeModule;
       private Dictionary<int, Product> _products = new();
       private StoreConfig _store = new(5.90m, 60m, 0.20m, "EUR");
       private PromoPreview? _promo;

       protected override void OnInitialized()
       {
              Watch(Machine);
              // Le panier se restaure en asynchrone depuis le session storage (CartSync) :
              // sans cette observation, un rendu initial à 0 ligne resterait figé
              // (bouton « Suivant » désactivé pour toujours) — course révélée en conteneur.
              if (Cart is IObservableState cartState) Watch(cartState);
       }

       protected override async Task OnInitializedAsync()
       {
              // Récapitulatif latéral (docs/32) : noms/images/prix pour l'aperçu panier,
              // MÊME règle de livraison/TVA que le serveur, aperçu du code promo du panier.
              var all = await Products.GetAllAsync();
              _products = all.ToDictionary(p => p.Id);
              _store = await StoreConfigProvider.GetAsync();
              if (Cart.PromoCode is { } code)
                     _promo = await Promos.ValidateAsync(code, CartSubtotal);
       }

       // ---- Récapitulatif « Votre commande » : la commande persistée fait foi dès
       // qu'elle existe (étapes paiement/confirmation) ; avant, aperçu recalculé
       // avec les mêmes règles Domain/config que le serveur. ----

       private record SummaryLine(int ProductId, string Name, int Quantity, decimal LineTotal);

       private IReadOnlyList<SummaryLine> SummaryLines =>
              _order is not null
                     ? [.. _order.Lines.Select(l => new SummaryLine(l.ProductId, l.ProductName, l.Quantity, l.LineTotal))]
                     : [.. Cart.Lines.Select(l => new SummaryLine(l.ProductId,
                            _products.TryGetValue(l.ProductId, out var p) ? p.Name : $"Produit {l.ProductId}",
                            l.Quantity,
                            _products.TryGetValue(l.ProductId, out var p2) ? p2.Price * l.Quantity : 0))];

       private decimal CartSubtotal => Cart.Lines.Sum(l =>
              _products.TryGetValue(l.ProductId, out var p) ? p.Price * l.Quantity : 0);

       private decimal SummarySubtotal => _order?.Subtotal ?? CartSubtotal;
       private decimal SummaryDiscount => _order?.Discount ?? _promo?.DiscountFor(SummarySubtotal) ?? 0m;
       private string? SummaryPromoCode => _order?.PromoCode ?? Cart.PromoCode;
       private decimal SummaryShipping => _order?.ShippingCost ?? _store.ShippingFor(SummarySubtotal - SummaryDiscount);
       private decimal SummaryTotal => _order?.Total ?? SummarySubtotal - SummaryDiscount + SummaryShipping;
       private decimal SummaryTax => _order?.TaxAmount ?? _store.VatIncludedIn(SummaryTotal);

       private void OnShippingSubmitted(ShippingForm form)
       {
              _shipping = form;
              // Une clé PAR TENTATIVE d'achat, stable pendant les reprises (retry réseau,
              // double-clic) : le serveur rejoue la commande existante au lieu d'en créer une.
              _idempotencyKey = Guid.NewGuid().ToString("N");
              Machine.Fire(CheckoutEvent.Next);
       }

       /// <summary>« Payer » : crée la commande (idempotent) puis ouvre la session de paiement.
       /// La commande reste Pending tant que le webhook (ou le simulateur) ne l'a pas confirmée.</summary>
       private async Task PayAsync()
       {
              if (_placing || _shipping is null || _idempotencyKey is null) return;
              _placing = true;
              _error = null;
              try
              {
                     var placement = await OrderPlacer.PlaceOrderAsync(new(
                            _shipping.Email, _shipping.FullName, _shipping.Address, _shipping.PostalCode,
                            [.. Cart.Lines.Select(l => new CartLineRequest(l.ProductId, l.Quantity))],
                            _idempotencyKey, PromoCode: Cart.PromoCode));

                     if (placement.Order is null)
                     {
                            _error = placement.Message;
                            Machine.Fire(CheckoutEvent.PaymentFailed);
                            return;
                     }

                     _order = placement.Order;
                     _session = await Payments.CreateSessionAsync(_order.Id);
                     if (_session is null)
                     {
                            _error = "Impossible d'ouvrir la session de paiement. Réessayez.";
                            _order = null;
                     }
              }
              finally
              {
                     _placing = false;
              }
       }

       /// <summary>Montage du Payment Element APRÈS le rendu (jamais pendant le prerender).</summary>
       protected override async Task OnAfterRenderAsync(bool firstRender)
       {
              if (_session is { Live: true, PublishableKey: not null } && !_elementMounted)
              {
                     _stripeModule ??= await JS.InvokeAsync<IJSObjectReference>(
                            "import", "./js/stripe-payment.js");
                     await _stripeModule.InvokeVoidAsync("mountPaymentElement",
                            _session.PublishableKey, _session.ClientSecret, "stripe-payment-element");
                     _elementMounted = true;
              }
       }

       private async Task ConfirmStripeAsync()
       {
              if (_placing || _stripeModule is null) return;
              _placing = true;
              _paymentError = null;
              try
              {
                     var error = await _stripeModule.InvokeAsync<string?>("confirmPayment",
                            Nav.ToAbsoluteUri("/checkout").ToString());
                     if (error is not null)
                     {
                            _paymentError = error;
                            return;
                     }
                     // La confirmation navigateur n'est pas une preuve : on attend que le
                     // webhook signé fasse passer la commande à Paid (sondage ~15 s max).
                     if (await WaitForPaidAsync())
                     {
                            Cart.Clear();
                            Machine.Fire(CheckoutEvent.Pay);
                     }
                     else
                     {
                            _paymentError = "Paiement en cours de confirmation — retrouvez votre commande dans « Mes commandes ».";
                     }
              }
              finally
              {
                     _placing = false;
              }
       }

       private async Task FakePayAsync()
       {
              if (_placing || _order is null) return;
              _placing = true;
              try
              {
                     if (await Payments.FakeConfirmAsync(_order.Id))
                     {
                            Cart.Clear();
                            Machine.Fire(CheckoutEvent.Pay);
                     }
                     else
                     {
                            _paymentError = "La confirmation simulée a échoué.";
                     }
              }
              finally
              {
                     _placing = false;
              }
       }

       private async Task<bool> WaitForPaidAsync()
       {
              for (var i = 0; i < 15; i++)
              {
                     var order = await OrderHistory.GetByIdAsync(_order!.Id);
                     if (order?.Status == OrderStatus.Paid) return true;
                     await Task.Delay(1000);
              }
              return false;
       }

       /// <summary>Message WhatsApp professionnel pré-rempli pour la commande confirmée :
       /// référence et montant inclus — le client n'a rien à recopier (docs/31).</summary>
       private string OrderWhatsAppMessage =>
              _order is null ? "" :
              $"Bonjour ShopPulse, je vous contacte au sujet de ma commande " +
              $"n° {_order.Id.ToString("N")[..8].ToUpperInvariant()} d'un montant de " +
              $"{_order.Total:0.00} {_order.Currency}. Merci de me tenir informé de son avancement.";

       public async ValueTask DisposeAsync()
       {
              if (_stripeModule is not null)
                     await _stripeModule.DisposeAsync();
       }
}
