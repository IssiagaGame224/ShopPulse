@page "/account/orders"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using ShopPulse.UI.Resources
@inject IOrderHistory Orders
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["MyOrders"] — ShopPulse</PageTitle>
<h1>@L["MyOrders"]</h1>

@if (_orders is null)
{
       <p aria-busy="true">@L["Loading"]</p>
}
else if (_orders.Count == 0)
{
       <p>@L["OrdersEmpty"] <a href="/catalog">@L["CatalogTitle"]</a></p>
}
else
{
       <ul>
              @foreach (var order in _orders)
              {
                     <li @key="order.Id">
                            <a href="/account/orders/@order.Id">
                                   @L["TrackingTitle"] @order.Id.ToString("N")[..8].ToUpperInvariant()
                            </a>
                            — @order.CreatedAt.ToString("dd/MM/yyyy"), @order.Total.ToString("0.00") @order.Currency
                            (@StatusLabel(order.Status))
                     </li>
              }
       </ul>
}

@code {
       private IReadOnlyList<Order>? _orders;

       protected override async Task OnInitializedAsync() =>
              _orders = await Orders.GetMyOrdersAsync();

       private string StatusLabel(OrderStatus status) => status switch
       {
              OrderStatus.Pending => L["StatusPending"],
              OrderStatus.Paid => L["StatusPaid"],
              OrderStatus.Shipped => L["StatusShipped"],
              OrderStatus.Cancelled => L["StatusCancelled"],
              _ => status.ToString(),
       };
}
