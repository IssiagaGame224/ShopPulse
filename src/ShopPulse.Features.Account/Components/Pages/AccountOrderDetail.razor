@page "/account/orders/{Id:guid}"
@attribute [Authorize]
@using Microsoft.Extensions.Localization
@using ShopPulse.UI.Resources
@inject IOrderHistory Orders
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["TrackingTitle"] — ShopPulse</PageTitle>

@if (_order is null)
{
       <h1>@L["OrderNotFound"]</h1>
       <p>@L["OrderNotFoundHint"]</p>
}
else
{
       <h1>@L["TrackingTitle"] @Id.ToString("N")[..8].ToUpperInvariant()</h1>
       <p>@string.Format(L["PlacedOn"], _order.CreatedAt.ToString("dd/MM/yyyy")) — @StatusLabel(_order.Status)</p>

       <ul>
              @foreach (var line in _order.Lines)
              {
                     <li>@line.Quantity × @line.ProductName — @line.LineTotal.ToString("0.00") @_order.Currency</li>
              }
       </ul>
       <dl class="summary-box">
              <div>
                     <dt>@L["Subtotal"]</dt>
                     <dd>@_order.Subtotal.ToString("0.00") @_order.Currency</dd>
              </div>
              <div>
                     <dt>@L["Shipping"]</dt>
                     <dd>@(_order.ShippingCost > 0 ? $"{_order.ShippingCost:0.00} {_order.Currency}" : L["ShippingFree"].Value)</dd>
              </div>
              <div class="total">
                     <dt>@L["TotalLabel"]</dt>
                     <dd>@_order.Total.ToString("0.00") @_order.Currency</dd>
              </div>
              <div>
                     <dt>@string.Format(L["VatIncluded"], (_order.TaxRate * 100).ToString("0"))</dt>
                     <dd>@_order.TaxAmount.ToString("0.00") @_order.Currency</dd>
              </div>
       </dl>

       <h2>@L["Shipping"]</h2>
       <p>@_order.FullName<br />@_order.Address<br />@_order.PostalCode</p>

       <p><a href="/account/orders">← @L["MyOrders"]</a></p>
}

@code {
       [Parameter] public Guid Id { get; set; }
       private Order? _order;

       protected override async Task OnInitializedAsync() =>
              _order = await Orders.GetByIdAsync(Id);

       private string StatusLabel(OrderStatus status) => status switch
       {
              OrderStatus.Pending => L["StatusPending"],
              OrderStatus.Paid => L["StatusPaid"],
              OrderStatus.Shipped => L["StatusShipped"],
              OrderStatus.Cancelled => L["StatusCancelled"],
              _ => status.ToString(),
       };
}
