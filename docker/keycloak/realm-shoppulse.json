{
  "realm": "shoppulse",
  "enabled": true,
  "clients": [
    {
      "clientId": "shoppulse-web",
      "name": "ShopPulse Web",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-shoppulse",
      "redirectUris": [
        "http://localhost:5026/*"
      ],
      "webOrigins": [
        "http://localhost:5026"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "user.attribute": "foo",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "stock-manager",
        "description": "Gestion du stock (back-office)"
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@shoppulse.local",
      "firstName": "Démo",
      "lastName": "ShopPulse",
      "credentials": [
        {
          "type": "password",
          "value": "demo1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "stock-manager",
        "default-roles-shoppulse"
      ]
    },
    {
      "username": "client",
      "enabled": true,
      "email": "client@shoppulse.local",
      "firstName": "Camille",
      "lastName": "Cliente",
      "credentials": [
        {
          "type": "password",
          "value": "client1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-shoppulse"
      ]
    }
  ],
  "accessTokenLifespan": 1800
}